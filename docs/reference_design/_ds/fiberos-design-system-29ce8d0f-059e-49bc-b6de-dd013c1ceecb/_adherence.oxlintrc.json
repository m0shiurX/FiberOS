      {
        "selector": "JSXOpeningElement[name.name='StackedBarSegment'] > JSXAttribute > JSXIdentifier[name!=/^(?:label|value|color|key|ref|className|style|children)$/]",
        "message": "<StackedBarSegment> doesn't accept that prop. Declared props: label, value, color."
