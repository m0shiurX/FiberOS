      {
        "selector": "JSXOpeningElement[name.name='SparkArea'] > JSXAttribute > JSXIdentifier[name!=/^(?:data|height|color|fill|strokeWidth|style|key|ref|className|style|children)$/]",
        "message": "<SparkArea> doesn't accept that prop. Declared props: data, height, color, fill, strokeWidth, style."
